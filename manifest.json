{
  "manifest_version": 3,
  "name": "LinkedIn Post Genie",
  "version": "1.0.0",
  "description": "Turn the latest news in your field, AI security and future tech into LinkedIn posts that get recruiters and leaders to notice you.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkedIn Post Genie",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
